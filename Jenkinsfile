pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out e-commerce project'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests'
            }
        }

        stage('Docker') {
            steps {
                echo 'Docker stage'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'
            }
        }
    }
}
